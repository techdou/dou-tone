# ── 私密信息与密钥：绝不入库 ──
.env
.env.*
*.key
*.pem
*.p12
*.pfx
secrets*
credentials*
*.token
_htpasswd

# ── 开发软件配置目录：本地工具状态不上传 ──
.claude/
.claude.json
.codex/
.cursor/
.gemini/
.zcode/
.vscode/
.idea/
.windsurf/
